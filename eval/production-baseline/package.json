{
  "name": "dsh-prompt-craft",
  "version": "1.0.0",
  "type": "module",
  "description": "Preview-first prompt enhancement for DeepSeek Harness: it clarifies a draft without inventing facts, asks instead of filling placeholders, and writes back only when you click apply.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "prompt",
    "prompt-engineering",
    "prompt-enhancer",
    "composer"
  ],
  "license": "MIT",
  "author": "Ethan (https://github.com/scnu2024)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scnu2024/dsh-prompt-craft.git"
  },
  "bugs": {
    "url": "https://github.com/scnu2024/dsh-prompt-craft/issues"
  },
  "homepage": "https://github.com/scnu2024/dsh-prompt-craft#readme",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/prompt.js && node --check lib/gate.js && node --check lib/protocol.js && node --check lib/prefs.js && node --check lib/history.js && node --check lib/model.js && node --check lib/route.js && node --check lib/strategy.js",
    "test": "node --test test/*.test.mjs",
    "eval:dev": "node eval/run.mjs dev",
    "eval:accept": "node eval/run.mjs accept"
  }
}
